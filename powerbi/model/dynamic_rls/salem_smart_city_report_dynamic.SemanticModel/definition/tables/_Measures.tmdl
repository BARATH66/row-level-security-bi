table _Measures
	lineageTag: 754ad9ec-880c-5365-849f-3a1089904cb3

	/// Domains the signed-in user can see. RLS filters survive ALL(), so managers get 6 and each operator gets 1.
	measure 'Visible Domains' = COUNTROWS(ALL(DimCategory))
		formatString: 0
		displayFolder: Access
		lineageTag: cec4ca67-9f80-5fe3-9dbb-ce06a8a689f3

	/// TRUE for the Manager role (and in Desktop with no role applied).
	measure 'Is Manager View' = [Visible Domains] >= 6
		displayFolder: Access
		lineageTag: 5286011b-a2f1-5d23-857b-a490af11727c

	measure 'Access Message' = IF([Is Manager View], "Manager view - all 6 city domains", "Restricted - the Overview is available to managers only. Use your domain pages.")
		displayFolder: Access
		lineageTag: eda00506-a115-532a-9914-4cebce76c4eb

	measure 'Total Open Alarms (City)' = IF([Is Manager View], [Open Alarms])
		formatString: #,0
		displayFolder: Overview
		lineageTag: ad170bc0-0eb7-5c17-98e2-24ff8e92f6d9

	measure 'Total Open Incidents (City)' = IF([Is Manager View], [Open Incidents] + [In Progress Incidents])
		formatString: #,0
		displayFolder: Overview
		lineageTag: 72fd31e6-f64d-5689-a895-f1f7749d874c

	measure 'OV AQ Avg AQI' = IF([Is Manager View], CALCULATE([Avg AQI], DimCategory[DomainCode] = "AQ"))
		formatString: 0
		displayFolder: Overview
		lineageTag: a703699c-3807-5b81-9287-ae1c2633ba83

	measure 'OV AQ Poor Air Readings %' = IF([Is Manager View], CALCULATE([Poor Air Readings %], DimCategory[DomainCode] = "AQ"))
		formatString: 0.0%
		displayFolder: Overview
		lineageTag: a83a6c2d-4399-5e9d-b198-948893c090c4

	measure 'OV AQ Open Alarms' = IF([Is Manager View], CALCULATE([Open Alarms], DimCategory[DomainCode] = "AQ"))
		formatString: #,0
		displayFolder: Overview
		lineageTag: ff8599f7-ab4f-5f57-9bdf-5c690e2c9696

	measure 'OV AQ Open Incidents' = IF([Is Manager View], CALCULATE([Open Incidents] + [In Progress Incidents], DimCategory[DomainCode] = "AQ"))
		formatString: #,0
		displayFolder: Overview
		lineageTag: 03bb7719-942f-5e4b-bb3a-2be58e4c64ff

	measure 'OV SWM Waste Collected (t)' = IF([Is Manager View], CALCULATE([Waste Collected (t)], DimCategory[DomainCode] = "SWM"))
		formatString: #,0.0
