	column Placeholder
		dataType: int64
		isHidden
		lineageTag: 60e8826f-0f39-557e-a0d3-f98c8e05e5ab
		summarizeBy: none
		sourceColumn: Placeholder

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table({"Placeholder"}, {{1}}),
				    Typed = Table.TransformColumnTypes(Source, {{"Placeholder", Int64.Type}})
				in
				    Typed

	annotation PBI_ResultType = Table

