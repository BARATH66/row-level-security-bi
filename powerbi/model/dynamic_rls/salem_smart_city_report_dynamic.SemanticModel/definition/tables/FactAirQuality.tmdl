table FactAirQuality
	lineageTag: e0b23778-dd29-55ef-955a-8e18eabf866b

	measure 'Avg AQI' = AVERAGE(FactAirQuality[AQI])
		formatString: 0
		displayFolder: Air Quality
		lineageTag: 943bb725-db68-56c3-92a2-cfc526875f57

	measure 'Max AQI' = MAX(FactAirQuality[AQI])
		formatString: 0
		displayFolder: Air Quality
		lineageTag: 6708aa1f-a35d-5a72-b294-b6a1a4538d47

	measure 'Avg PM2.5' = AVERAGE(FactAirQuality[PM25])
		formatString: 0.0
		displayFolder: Air Quality
		lineageTag: a79dee12-dc97-511d-8bfd-2e899e02f1d9

	measure 'Avg PM10' = AVERAGE(FactAirQuality[PM10])
		formatString: 0.0
		displayFolder: Air Quality
		lineageTag: 7a9adb72-7403-5334-a627-9fcf0cd287ac

	measure 'Avg NO2' = AVERAGE(FactAirQuality[NO2])
		formatString: 0.0
		displayFolder: Air Quality
		lineageTag: 45427077-c68d-5b4f-a909-bd2495d73ad7

	measure 'Avg SO2' = AVERAGE(FactAirQuality[SO2])
		formatString: 0.0
		displayFolder: Air Quality
		lineageTag: 51120e36-cd06-5508-a94f-15417ff92235

	measure 'Avg Temperature' = AVERAGE(FactAirQuality[Temperature])
		formatString: 0.0
		displayFolder: Air Quality
		lineageTag: 826962f9-7adc-5dde-9e6a-475a48d0bdb0

	measure 'Avg Humidity' = AVERAGE(FactAirQuality[Humidity])
		formatString: 0.0
		displayFolder: Air Quality
		lineageTag: 629ba083-bbdc-523f-aae3-1aceb2cc4f4d

	measure Readings = COUNTROWS(FactAirQuality)
		formatString: #,0
		displayFolder: Air Quality
		lineageTag: 0a415bf4-c55f-5e43-bddc-6455d4771196

	measure 'Stations Reporting' = DISTINCTCOUNT(FactAirQuality[StationName])
		formatString: 0
		displayFolder: Air Quality
		lineageTag: a02bcd92-cc4e-5c04-a406-deeb935981b1

	measure 'Poor Air Readings %' = DIVIDE(CALCULATE(COUNTROWS(FactAirQuality), FactAirQuality[AQI] > 100), COUNTROWS(FactAirQuality))
		formatString: 0.0%
		displayFolder: Air Quality
		lineageTag: 872fffea-3e39-55e6-8fbf-87b36eaeb394

