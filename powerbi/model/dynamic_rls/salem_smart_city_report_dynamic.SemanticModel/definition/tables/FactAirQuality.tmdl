	partition FactAirQuality = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "FactAirQuality.csv"), [Delimiter=",", Columns=13, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Date", type date}, {"TenantID", Int64.Type}, {"CategoryKey", Int64.Type}, {"StationName", type text}, {"PM25", type number}, {"PM10", type number}, {"NO2", type number}, {"SO2", type number}, {"CO", type number}, {"AQI", Int64.Type}, {"AQIBand", type text}, {"Temperature", type number}, {"Humidity", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

