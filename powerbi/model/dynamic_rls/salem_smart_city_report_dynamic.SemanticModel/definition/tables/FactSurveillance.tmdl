	partition FactSurveillance = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "FactSurveillance.csv"), [Delimiter=",", Columns=10, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Date", type date}, {"TenantID", Int64.Type}, {"CategoryKey", Int64.Type}, {"CameraType", type text}, {"CamerasTotal", Int64.Type}, {"CamerasOnline", Int64.Type}, {"EventsDetected", Int64.Type}, {"Violations", Int64.Type}, {"AlertsRaised", Int64.Type}, {"AvgResponseMin", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

