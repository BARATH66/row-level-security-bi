table FactSurveillance
	lineageTag: 955a3f9d-6213-5aae-9fd8-2d254e4274f2

	measure 'Camera Uptime %' = DIVIDE(SUM(FactSurveillance[CamerasOnline]), SUM(FactSurveillance[CamerasTotal]))
		formatString: 0.0%
		displayFolder: City Surveillance
		lineageTag: 3c9ecc09-8321-5777-81c4-f2c2e993bb29

	measure 'Cameras Deployed' = DIVIDE(SUM(FactSurveillance[CamerasTotal]), DISTINCTCOUNT(FactSurveillance[Date]))
		formatString: #,0
		displayFolder: City Surveillance
		lineageTag: bc8564c9-d4aa-51aa-85e5-8653678db3c6

	measure 'Events Detected' = SUM(FactSurveillance[EventsDetected])
		formatString: #,0
		displayFolder: City Surveillance
		lineageTag: a7b503a8-8a6d-5843-8b8c-3de9f534f284

	measure 'Violations Detected' = SUM(FactSurveillance[Violations])
		formatString: #,0
		displayFolder: City Surveillance
		lineageTag: 8667edda-7429-5755-90fc-d2a0817055de

	measure 'Alerts Raised' = SUM(FactSurveillance[AlertsRaised])
		formatString: #,0
		displayFolder: City Surveillance
		lineageTag: 5489aa18-2378-58c4-bb1f-afa4efa36feb

	measure 'Avg Response (min)' = AVERAGE(FactSurveillance[AvgResponseMin])
		formatString: 0.0
		displayFolder: City Surveillance
		lineageTag: d6282618-34e6-5cac-9bab-87e8d6745f96

	column Date
		dataType: dateTime
		isHidden
		formatString: Long Date
		lineageTag: 4eeeb157-d5f4-5259-99d6-e4a620350d48
