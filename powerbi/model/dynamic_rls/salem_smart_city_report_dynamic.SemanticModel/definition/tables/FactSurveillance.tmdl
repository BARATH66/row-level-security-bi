		summarizeBy: none
		sourceColumn: CategoryKey

	column CameraType
		dataType: string
		lineageTag: ce847f77-abdf-5fca-9bda-5684b88031d0
		summarizeBy: none
		sourceColumn: CameraType

	column CamerasTotal
		dataType: int64
		lineageTag: 85e02f10-cb21-5423-9743-300f45242372
		sourceColumn: CamerasTotal

	column CamerasOnline
		dataType: int64
		lineageTag: 2e2ce917-14d5-574d-9e36-b6225b286f22
		sourceColumn: CamerasOnline

	column EventsDetected
