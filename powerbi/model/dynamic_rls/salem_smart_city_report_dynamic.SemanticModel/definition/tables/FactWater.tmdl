	partition FactWater = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "FactWater.csv"), [Delimiter=",", Columns=13, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Date", type date}, {"TenantID", Int64.Type}, {"CategoryKey", Int64.Type}, {"SupplySource", type text}, {"SupplyKL", type number}, {"ConsumptionKL", type number}, {"LeakageKL", type number}, {"PressureBar", type number}, {"ChlorineMgL", type number}, {"TurbidityNTU", type number}, {"ReservoirLevelPct", type number}, {"QualityTestsDone", Int64.Type}, {"QualityTestsPassed", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

