table FactWater
	lineageTag: 40bc10a0-781b-51e7-a31b-2eb3d2520db9

	measure 'Water Supplied (ML)' = DIVIDE(SUM(FactWater[SupplyKL]), 1000)
		formatString: #,0.0
		displayFolder: Water Management
		lineageTag: ecc33927-1260-5df2-81e6-9fda2a2f2e9c

	measure 'Water Consumed (ML)' = DIVIDE(SUM(FactWater[ConsumptionKL]), 1000)
		formatString: #,0.0
		displayFolder: Water Management
		lineageTag: c96ad742-36c9-53df-a259-add29a50d76d

	measure 'Non-Revenue Water %' = DIVIDE(SUM(FactWater[SupplyKL]) - SUM(FactWater[ConsumptionKL]), SUM(FactWater[SupplyKL]))
		formatString: 0.0%
		displayFolder: Water Management
		lineageTag: b0dc2265-07b0-52d8-b7e2-1cff480c7b25

	measure 'Leakage (KL)' = SUM(FactWater[LeakageKL])
		formatString: #,0
		displayFolder: Water Management
		lineageTag: 9e0a9f3d-ac31-5756-9092-e63001710f6f

	measure 'Avg Pressure (bar)' = AVERAGE(FactWater[PressureBar])
		formatString: 0.00
		displayFolder: Water Management
		lineageTag: dac668c6-440f-5e4c-91d3-4093a47ae605

	measure 'Avg Chlorine (mg/L)' = AVERAGE(FactWater[ChlorineMgL])
		formatString: 0.00
		displayFolder: Water Management
		lineageTag: 8debad40-4bfa-5748-985e-ef96f7a55d4b

	measure 'Avg Turbidity (NTU)' = AVERAGE(FactWater[TurbidityNTU])
		formatString: 0.00
		displayFolder: Water Management
		lineageTag: 6349943b-4913-5d78-a33f-79c1bb27470b

	measure 'Avg Reservoir Level %' = DIVIDE(AVERAGE(FactWater[ReservoirLevelPct]), 100)
		formatString: 0.0%
		displayFolder: Water Management
		lineageTag: 5689fb54-dff8-5caa-88e5-437321a7f715

	measure 'Quality Compliance %' = DIVIDE(SUM(FactWater[QualityTestsPassed]), SUM(FactWater[QualityTestsDone]))
		formatString: 0.0%
		displayFolder: Water Management
		lineageTag: fc99a75d-8a1f-520c-9df6-9ab6266b74c1

	column Date
		dataType: dateTime
		isHidden
		formatString: Long Date
		lineageTag: 544fc631-c89a-5595-a417-d3b374e0f7c6
