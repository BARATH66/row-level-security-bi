	partition FactSWM = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "FactSWM.csv"), [Delimiter=",", Columns=11, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Typed = Table.TransformColumnTypes(Promoted, {{"Date", type date}, {"TenantID", Int64.Type}, {"CategoryKey", Int64.Type}, {"WasteType", type text}, {"VehiclesDeployed", Int64.Type}, {"PlannedPickups", Int64.Type}, {"CompletedPickups", Int64.Type}, {"WasteTonnes", type number}, {"ProcessedTonnes", type number}, {"AvgBinFillPct", type number}, {"SegregationPct", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

