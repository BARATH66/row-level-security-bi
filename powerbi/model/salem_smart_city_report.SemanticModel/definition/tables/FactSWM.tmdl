table FactSWM
	lineageTag: 735172ab-f1b5-5ae5-92a7-dbbcaad7f27a

	measure 'Waste Collected (t)' = SUM(FactSWM[WasteTonnes])
		formatString: #,0.0
		displayFolder: Solid Waste Management
		lineageTag: 01000cdb-adb4-5e06-bc84-ee498afe71fe

	measure 'Waste Processed (t)' = SUM(FactSWM[ProcessedTonnes])
		formatString: #,0.0
		displayFolder: Solid Waste Management
		lineageTag: d316693a-59f3-54dd-8386-a28717d2f71b

	measure 'Processing Rate %' = DIVIDE([Waste Processed (t)], [Waste Collected (t)])
		formatString: 0.0%
		displayFolder: Solid Waste Management
		lineageTag: 30ee0dff-22f0-5b3a-949c-c42aa7f85a41

	measure 'Collection Efficiency %' = DIVIDE(SUM(FactSWM[CompletedPickups]), SUM(FactSWM[PlannedPickups]))
		formatString: 0.0%
		displayFolder: Solid Waste Management
		lineageTag: 1acc0231-c137-5889-911d-e18e88c79c08

	measure 'Pending Pickups' = SUM(FactSWM[PlannedPickups]) - SUM(FactSWM[CompletedPickups])
		formatString: #,0
		displayFolder: Solid Waste Management
		lineageTag: bf61c5ee-9a94-50a9-a306-7f574915d8e9

	measure 'Avg Bin Fill %' = DIVIDE(AVERAGE(FactSWM[AvgBinFillPct]), 100)
		formatString: 0.0%
		displayFolder: Solid Waste Management
		lineageTag: 240fb62b-3fcc-5c00-841b-ab6b7372227c

	measure 'Segregation %' = DIVIDE(AVERAGE(FactSWM[SegregationPct]), 100)
		formatString: 0.0%
		displayFolder: Solid Waste Management
		lineageTag: afa54bf6-68c7-5074-a797-b35a53be1647

	measure 'Avg Vehicles Deployed' = AVERAGE(FactSWM[VehiclesDeployed])
		formatString: 0.0
		displayFolder: Solid Waste Management
		lineageTag: 8835e477-2632-5780-b276-5edd9830dad1

